__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Frontend test scaffolding (Playwright + npm) — tied to phase-2 card
# prototype work that isn't shipped with the integration. Never commit.
frontend/tests/
node_modules/
package-lock.json

# Local code-knowledge-graph output (graphify). Regenerable from source at no
# cost, and large — never committed.
graphify-out/
.graphify_python

# Opt-in switch for rebuilding the local code graph. Per working copy, never
# committed: its absence is what keeps a rebuild from firing on a deploy target,
# a CI runner or a throwaway clone.
.graphify-enabled
